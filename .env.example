# Claude. Without a key, the bot runs as a menu-only bot.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=low

# Your business config
BUSINESS_FILE=examples/salon.json

# memory | supabase
STORE=memory
SUPABASE_URL=
# Server only. Never ship this key to a browser or app.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (needed for `npm start`, not for `npm run chat`)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta, used to check webhook signatures.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
# ALLOW_UNSIGNED_WEBHOOKS=1   # local testing only

PORT=3000
